NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/gods-plan-for-men

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*
# Optional. Uploaded files are stored as relative paths (/uploads/...).
# Mobile and dashboard build the full URL from their own API config.
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Stripe keys for the in-app card sheet. No webhook signing secret is required.
# Publishable key is the pk_test_ value on the same Stripe API keys page.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
